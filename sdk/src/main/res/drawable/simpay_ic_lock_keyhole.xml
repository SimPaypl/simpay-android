<?xml version="1.0" encoding="utf-8"?>
<!--
    Lock with a keyhole, used next to the "payments are encrypted" note.

    Drawn as a stroked outline so it matches the rest of the sheet typography and can
    be tinted with the surrounding text colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#667085">

    <!-- Keyhole -->
    <path
        android:pathData="M13,16a1,1 0 1,1 -2,0a1,1 0 1,1 2,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Body -->
    <path
        android:pathData="M5,10h14a2,2 0 0 1 2,2v8a2,2 0 0 1 -2,2h-14a2,2 0 0 1 -2,-2v-8a2,2 0 0 1 2,-2z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Shackle -->
    <path
        android:pathData="M7,10V7a5,5 0 0 1 10,0v3"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>

